# Capstone 1 - The Voting App
# Global Docker exclusion rules to prevent secrets, caches, and unnecessary files in build context

# Git and version control
.git
.gitignore
.gitattributes
.github
.gitlab
.gitlab-ci.yml

# Secrets and credentials (CRITICAL - never copy to build context)
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.env
*.env.*
.env.local
.env.*.local
secrets/
**/secrets/
*.secret
*.password
*.token
*.api
aws-credentials
docker-config.json
.docker/config.json

# Terraform and infrastructure
terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
.terraform.lock.hcl
terraform.tfplan
plan.out

# Kubernetes and Helm
kubeconfig
*.kubeconfig
helm/
charts/
*.tgz
Chart.lock

# CI/CD pipelines
.github/workflows/
.gitlab-ci.yml
Jenkinsfile
.azure-pipelines.yml
.circleci/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.suo
*.user
*.sln.docstates

# OS generated files
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/

