*.test.js
*.test.ts
*.spec.js
*.spec.ts
jest.config.js
vitest.config.ts
cypress/
playwright/
*.cy.js
*.cy.ts

# Database and migration files (source only, not for runtime)
migrations/
*.sql
!db/init.sql

# Docker and container
Dockerfile*
docker-compose*
.dockerignore
docker-compose.override.yml
docker-compose.*.yml
*.dockerfile

